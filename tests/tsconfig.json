{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "**/*.ts",
    "../infra/scripts/**/*.ts",
    "../apps/api/src/core/**/*.ts",
    "../apps/api/scripts/**/*.ts"
  ],
  "exclude": ["dist", "../apps/api/src/**/*.test.ts"],
  "references": [
    {
      "path": "../packages/shared"
    }
  ]
}
